{
  "name": "vibeember",
  "private": true,
  "version": "2.0.0",
  "description": "星火场 VibeEmber - 产品首发互助社区（pnpm monorepo：web / api / worker）",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" build && pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm --filter @vibeember/web lint",
    "lint:fix": "eslint . --fix && pnpm --filter @vibeember/web exec eslint . --fix",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm db:generate && pnpm --filter \"./packages/**\" build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @vibeember/database db:generate",
    "db:migrate": "pnpm --filter @vibeember/database db:migrate",
    "db:deploy": "pnpm --filter @vibeember/database db:deploy",
    "db:seed": "pnpm --filter @vibeember/database db:seed",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "pnpm --filter @vibeember/web exec eslint --fix --"
    ],
    "{apps/api,apps/worker,packages}/**/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  }
}
