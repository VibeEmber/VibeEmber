# ===== VibeEmber 环境配置 =====
# 开发默认值与本机 `docker compose up -d`（postgres/minio/mailpit）开箱即用；
# 应用代码内置了以下 dev 默认值，因此开发可以不建 .env，需要覆盖时再复制为 .env。
# 生产部署（Vercel / docker-compose.prod.yml）必须替换全部敏感值。

# ----- 数据库（PostgreSQL） -----
# 本地开发：默认连本机 docker compose 的 PostgreSQL
# Vercel 运行时：填 Neon 的 pooler 连接串（host 带 -pooler）并追加
#   ?pgbouncer=true&connection_limit=1（应对多函数实例）
# 注意：跑迁移（db:deploy / GitHub Actions 的 migrate workflow）要用 Neon 的
#   直连串（host 不带 -pooler、不加 pgbouncer 参数），否则 advisory lock 会失败
DATABASE_URL=postgresql://vibe:vibe@localhost:5432/vibeember

# ----- 应用（Next.js 全栈：页面 + /api） -----
WEB_URL=http://localhost:3000
# 生产必须替换为强随机值，例如：openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-32chars!
BETTER_AUTH_URL=http://localhost:3000
# 该邮箱首次登录自动成为管理员
BOOTSTRAP_ADMIN_EMAIL=admin@vibeember.dev
# Vercel Cron 调度凭据（仅云端需要；Docker 部署用进程内定时器，不需要）
# CRON_SECRET=

# ----- GitHub OAuth（https://github.com/settings/developers 创建 OAuth App） -----
# 回调地址填 {BETTER_AUTH_URL}/api/auth/callback/github（开发即 http://localhost:3000/api/auth/callback/github）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- 邮件 -----
# 开发默认指向 mailpit（http://localhost:8025 网页查看验证码邮件）；生产改为真实 SMTP（465/587）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=星火场 <noreply@vibember.dev>

# ----- S3 存储（头像 / 产品 Logo / 截图 / 产品二维码） -----
# 开发默认指向本机 docker compose 的 MinIO（控制台 http://localhost:9001）
# 云端部署换成你自己的 S3 兼容服务即可，代码零改动
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=vibe
S3_SECRET_KEY=vibeember-secret
S3_BUCKET=vibeember
S3_PUBLIC_URL=http://localhost:9000/vibeember
S3_FORCE_PATH_STYLE=1

# ----- 生产 docker-compose.prod.yml 专用 -----
POSTGRES_PASSWORD=change-me-prod-password
# 生产域名：Caddy 会自动申请 HTTPS 证书（需先把域名 DNS 解析到服务器）
CADDY_DOMAIN=example.com
